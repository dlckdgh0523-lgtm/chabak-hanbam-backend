# ── 차박 하룻밤 서버 ─────────────────────────────────────────────
# 전부 제안값. 운영 배포 전 반드시 교체.

NODE_ENV=development            # production 이면 /demo/* 와 MOCK 이벤트 수용이 꺼짐
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chabak?schema=public

# ── 인증 ────────────────────────────────────────────────────────
# 사용자 JWT (폰 앱, scope=user). 32바이트 이상 랜덤.
JWT_USER_SECRET=change-me-user-secret-32bytes-minimum!!
JWT_USER_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# 장치 토큰 (차량 AAOS 앱 scope=vehicle, 폰 센서 scope=sensor).
# 서버가 발급하는 불투명 토큰 `dvt_<random>`. 해시만 저장. 이 값은 토큰 해시의 pepper.
DEVICE_TOKEN_PEPPER=change-me-device-pepper-32bytes-minimum!!

# 개발용 로그인 (POST /v1/auth/sessions provider=DEV). production 에서는 거부됨.
DEV_LOGIN_ENABLED=true

# ── 차량 앱 부트스트랩 ──────────────────────────────────────────
# 차량 앱이 처음 서버에 자신을 등록(POST /v1/pairings)할 때 쓰는 설치 비밀.
# 시연용. 실제로는 차량별 provisioning 으로 교체.
VEHICLE_ENROLL_SECRET=change-me-enroll-secret

# ── 외부 공급자 (전부 fixture 로 대체 가능) ───────────────────────
WEATHER_PROVIDER=fixture         # fixture | kma
KMA_API_KEY=
PLACES_PROVIDER=fixture          # fixture
LLM_PROVIDER=none                # none | anthropic
ANTHROPIC_API_KEY=
FCM_PROVIDER=log                 # log | fcm
FCM_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=log                 # log | sandbox
SMS_API_KEY=

# ── 신선도 (명세 9장 제안값, ms) ─────────────────────────────────
SENSOR_STALE_AFTER_MS=15000
VEHICLE_OFFLINE_AFTER_MS=30000
